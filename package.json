{
  "name": "hollywood-animal-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "dependencies": {
    "@preact/signals": "^1.3.2",
    "immer": "^10.0.0",
    "preact": "^10.20.2",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@preact/preset-vite": "^2.8.2",
    "@vitest/coverage-v8": "^1.5.2",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.5.2"
  }
}
